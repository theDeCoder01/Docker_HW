# ==========================================
# Secrets & Environment Variables
# ==========================================
# Keep actual secrets out of git
.env
.env.*
*.env

# Unignore the example template so collaborators have a reference
!.env.example

# ==========================================
# Docker & System Files
# ==========================================
# Docker Compose local overrides / temp logs
docker-compose.override.yml
*.log

# macOS system files (essential if testing on Mac!)
.DS_Store
.AppleDouble
.LSOverride

# Linux / Windows system files
Thumbs.db
ehthumbs.db

# ==========================================
# Python & Virtual Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/

# ==========================================
# IDE & Editor Files
# ==========================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains / PyCharm
.idea/

# Vim temporary files
*.swp
*.swo
*~